#include "../Ridah.hlsl"

// Standard 2D rotation formula.
float2x2 rot2(in float a){ float c = cos(a), s = sin(a); return float2x2(c, -s, s, c); }
float hash21(float2 p){  
    return fract(sin(mod(dot(p, float2(27.619, 57.583)), 6.2831589))*43758.5453); 
}
float hash21A(float2 p){  
    float x = fract(sin(dot(p, float2(27.619, 57.583)))*43758.5453); 
    return sin(x*6.2831 /*+ iTime/3.*/)*.5 + .5;
}
float sBoxS(in float2 p, in float2 b, in float rf){
  
  float2 d = abs(p) - b + rf;
  return min(max(d.x, d.y), 0.) + length(max(d, 0.)) - rf;
    
}
float n3D(float3 p){
    
    // Just some random figures, analogous to stride. You can change this, if you want.
	const float3 s = float3(27, 113, 57);
	
	float3 ip = floor(p); // Unique unit cell ID.
    
    // Setting up the stride vector for randomization and interpolation, kind of. 
    // All kinds of shortcuts are taken here. Refer to IQ's original formula.
    float4 h = float4(0., s.yz, s.y + s.z) + dot(ip, s);
    
	p -= ip; // Cell's fractional component.
	
    // A bit of cubic smoothing, to give the noise that rounded look.
    p = p*p*(3. - 2.*p);
    
    // Smoother version of the above. Weirdly, the extra calculations can sometimes
    // create a surface that's easier to hone in on, and can actually speed things up.
    // Having said that, I'm sticking with the simpler version above.
	//p = p*p*p*(p*(p * 6. - 15.) + 10.);
    
    // Even smoother, but this would have to be slower, surely?
	//float3 p3 = p*p*p; p = ( 7. + ( p3 - 7. ) * p ) * p3;	
	
    // Cosinusoidal smoothing. OK, but I prefer other methods.
    //p = .5 - .5*cos(p*3.14159);
    
    // Standard 3D noise stuff. Retrieving 8 random scalar values for each cube corner,
    // then interpolating along X. There are countless ways to randomize, but this is
    // the way most are familar with: fract(sin(x)*largeNumber).
    h = mix(fract(sin(h)*43758.5453), fract(sin(h + s.x)*43758.5453), p.x);
	
    // Interpolating along Y.
    h.xy = mix(h.xz, h.yw, p.y);
    
    // Interpolating along Z, and returning the 3D noise value.
    return mix(h.x, h.y, p.z); // Range: [0, 1].
	
}
float2 hash22(float2 p) { 

    // Faster, but doesn't disperse things quite as nicely. However, when framerate
    // is an issue, and it often is, this is a good one to use. Basically, it's a tweaked 
    // amalgamation I put together, based on a couple of other random algorithms I've 
    // seen around... so use it with caution, because I make a tonne of mistakes. :)
    float n = sin(dot(p, float2(27, 57)));
    //return fract(float2(262144, 32768)*n)*2. - 1.; 
    
    // Animated.
    p = fract(float2(262144, 32768)*n);
    return sin(p*6.2831853 + iTime*1.57); 
    
}
float distField(float2 p){
    
    // Saving the original position.
    float2 oP = p;
 
    // Cell ID and local coordinates.
    float2 ip = floor(p);
    p -= ip + .5;
    
    // Random value for the tile. This one is time based.
    float rnd = hash21A(ip);
    
    // If the random number generated by the unique ID for the
    // tile is above a certain threshold, flip it upside down.
    if(rnd<.5) p.y = -p.y;
  
    
    // Distance field.
    float d = 1e5;
    
    // Radius.
    float r = .09;
    
    // Two circles on diagonally opposite corners.
    d = min(d, length((p) - float2(-.5, .5)) - .5);
    d = min(d, length((p) - float2(.5, -.5)) - .5);

    // Some small circles down the center.
    float d2 = length(p - .3) - r*.9;
    d2 = min(d2, length(p - .1) - r*.7); 
    d2 = min(d2, length(p + .1) - r*.7); 
    d2 = min(d2, length(p + .3) - r*.9);  
    
    // Flip checkered tiles. It's a necessary operation to perform
    // for this style of Truchet tile.
    if(mod(ip.x + ip.y, 2.)<.5) d = -d;
    if(rnd>=.5) d = -d;
    
    // Put in some decorative borders. I like them, but you can take
    // them out if you feel it's too much.
    d = max((d - r*1.25), -(abs(abs(d ) - .05) - r/3.));
    
    // Combining the dotted lines and circles, whilst allowing for
    // the checkerboard flipping.
    if(mod(ip.x + ip.y, 2.)<.5){
        if(rnd<.5) d = max(d, -d2);
        else d = min(d, d2);
    }
    else {
       if(rnd<.5) d = min(d, d2);
        else d = max(d, -d2); 
    }
    
    // Adding a grid. Not necessary, but I like it.
    p = abs(p);
    float grid = abs(max(p.x, p.y) - .5) - .015;
    d = min(d, grid);
    
   
    // Rendering circles at the grid vertices, whilst accounting
    // for checkerboard flipping.
    float2  q = oP - .5;
    float2 iq = floor(q);
    q -= iq + .5;

    if(mod(iq.x + iq.y, 2.)<.5){
        d = min(d, length(q) - r*1.4);
    }
    else {
       d = max(d, -(length(q) - r*1.4));
    }
    

    // Return the distance field value.
    return d;
}
float2 skewXY(float2 p, float2 v){ return mul(float2x2(1, -v.y, v.x, 1),p); }
float2 unskewXY(float2 p, float2 v){ return mul(transpose(float2x2(1, -v.y, v.x, 1)),p); }//inverse
float4 bgField(float2 q2){
    
    // Helper variables: Scale, skewing vector, 
    // individual cell dimension, and block dimension.
    const float scale = 1./1.25;
	const float2 sk = float2(1, -1)/5.; // 12 x .2
	float2 dim = float2(1.5, 1)*scale;
	float2 s = (float2(2.5, 2.5) - abs(sk)/2.)*scale; // 12 x .2

    
    
    float d = 1e5;
    float2 cntr, p, ip;
    
    float2 id = F2(0);
    float2 l = dim;
    cntr = F2(0);
    float boxID = 0.;
    float2 offs = float2(1, 0);
    
    for(int i = 0; i<4; i++){
         
        // With herringbone arrangements, the rectangular tile needs to
        // be intermittently rotated by 90 degrees, which means flipping
        // dimensions, etc.
        if(i==2) {
            cntr = float2((dim.x + dim.y)/2., -dim.y/4.);
            l = l.yx;
            offs = offs.yx;
        }
        
    	p = q2 - cntr; // Local coordinates, based on a square grid.
    	p = skewXY(p, sk); // Skewing by the X and Y skewing values.
        ip = floor(p/s); // Local tile ID.
        p -= (ip + .5)*s; // New local position.
        p = unskewXY(p, sk); // Unskewing.

        
        // Individual positional tile ID.
        float2 idi = ip*s + cntr + l/2.;
        // Don't forget to unskew the ID... Yeah, skewing is confusing. :)
        idi = unskewXY(idi, sk);
        
        // The brick dimension itself. Not used here.
        //float di2D = sBoxS(p, l/2., .04);
       
 
        // We're rendering a large circle and two smaller circles in each 
        // rectangular tile, which are randomly flipped in accordance with
        // the tile ID.
        if(hash21(idi)<.5) p = -p;
        
        float lw = dim.y/4.; // Offset.
        float sz = dim.y/2.; // Size.
        float ew = .04*scale; // Empty border width, or margin, to CSS folk.
        
        float3 df;
        
        // Large circle, and two smaller circles.
        df.x = length(p - offs*lw) - (sz - ew);
        df.y = length(p + offs*lw*2. + offs.yx*lw) - (sz/2. - ew);
        df.z = length(p + offs*lw*2. - offs.yx*lw) - (sz/2. - ew);

        // A little offset circle inside the large circle.
        float2 rnd22 = hash22(idi);
        df.x = max(df.x, -(length(p - offs*lw - rnd22*(lw/2. + .05*scale)) - lw/2.5));          
 
        // Obtain the smallest of the three circles for this particular tile.
        float3 dfi = df.x<df.y && df.x<df.z? float3(df.x, offs*lw) :
        		   df.y<df.z? float3(df.y, offs*lw*2. + offs.yx*lw) :
        		   float3(df.z, offs*lw*2. - offs.yx*lw);
        
        // If one of the circle objects in this particular tile is smaller than the
        // overall smallest object, update the distance field, object ID, and make
        // a note of the rectangular tile ID.
        if(dfi.x<d){
            
            d = dfi.x;
            id = idi + dfi.yz;
            boxID = float(i);
            
        }
        
        // Move the position down by the longest length.
        cntr -= -dim.y;
        
    }
    
    // Return the distance, ID and rectangular tile ID.
    return float4(d, id, boxID);
}
float doHatch(float2 p, float res){
    
    
    // The pattern is physically based, so needs to factor in screen resolution.
    p *= res/16.;

    // Random looking diagonal hatch lines.
    float hatch = clamp(sin((p.x - p.y)*3.14159*200.)*2. + .5, 0., 1.); // Diagonal lines.

    // Slight randomization of the diagonal lines, but the trick is to do it with
    // tiny squares instead of pixels.
    float hRnd = hash21(floor(p*6.) + .73);
    if(hRnd>.66) hatch = hRnd;  

    // Return the hatch value.
    return hatch;
    
}
float4 woodGrain(in float3 p){

   
    // Noise.
    float ns = (n3D(p*96.)*.67 + n3D(p*192.)*.33);
    
    // Slight perturbation.
    //p += (n3D(2.5*p)*.66 + n3D(5.*p)*.34)*.5;
    p += (n3D(2.*p)*.57 + n3D(4.*p)*.28 + n3D(8.*p)*.15)*.5;
    
    // Stretching things out along one of the axes -- In this case the Y axis.
    p *= float3(1, 80, 1)*4.;
    
    // Cheap fract lines.
    float v = fract(-p.y*.1);
    //float v = fract(dot(p, float3(-.1)));
    v *= v;
    v = min(v, v*(1. - v)*5.); // Smoothing the fract lines.

    // Using the value above to produce the timber color. I did this a while
    // ago, but I'm sure I knew what I was doing at the time. :D
    float3 rWood = pow(min(float3(1.5, 1, 1)*mix(.3, .9, v), 1.), float3(1, 3, 12));
    float3 wood = mix(float3(.6, .4, .2), float3(1.2, .8, .4), v);
    //float3 wood = mix(float3(.5, .125, .025)/1.25, float3(.75, .27, .05)*1.5, v);
    //float3 wood = mix(float3(1, .8, .6)/3., float3(1.2, 1, .8), v);
    
    wood = mix(wood, rWood, .25 - v*.25);
    
    // Adding in a sprinking of noise.
    float3 rNoise = pow(min(float3(1, 1, 1)*mix(.8, 1., ns), 1.), float3(1, 2, 3));
    wood = min(wood*rNoise*1.1, 1.);
    
    // Toning things down, just a touch.
    //wood = pow(wood, float3(.95));
    
    // Returning the timber color value, and the distance value -- which in this
    // case, is just the red channel, but it could be something more sophisticated.
    return float4(wood, wood.x);
}


void FramePattern_float(float2 uv ,float scale,float2 _offset,out float4 fragColor)
{   uv*=scale;
    // Aspect correct screen coordinates.
    float ires = min(iResolution.y, 800.);
    
    uv -=_offset;
    // Scaling only.
    float gSc = 10.;
    float2 p = uv*gSc;
    
    // Saving a copy of the original.
    float2 oP = p;
    
    // Resolution based scaling.
    float sf = gSc/iResolution.y;

    // The framed distance field.
    float d = distField(p);
    
    // The background pattern.
    //float4 dBg = bgField(mul(rot2(-3.14159/4.),oP));
    
    // Frame width, rounding factors and frame dimensions.
    //const float frW = .45;
    //const float rF = .05, rF2 = .01;
    //float2 fDim = float2(14, 6);
    
    // #ifdef PATTERN_ONLY
    // A quick hack to display the Truchet pattern only.
    //fDim *= 2.;
    //#endif
    
    
    
    // The square frame.
    //float2 q = p;
    //float sqr = sBoxS(q, fDim/2. + frW*2., rF);
    //float fr = max(sqr, -sBoxS(q,fDim/2., rF2)); 
  
    // The frame shadow.
    //q = (p - float2(frW/2., -frW/2.));
    //float sqr2 = sBoxS(q, fDim/2. + frW*2., rF);
    //float fr2 = max(sqr2, -sBoxS(q, fDim/2., rF2));
    
    
    // Using a standard distance filed operation to cut down the size of 
    // the cavas to the frame.
    //d = max(d, sqr + frW*2.);

    
    // A hatch value, just to add a little extra texture here and there.
    float hatch = doHatch(oP/gSc, ires);
    
    
    // The timber color.
    //float frSh = clamp(.25 - fr/frW*2., 0., 1.);
    //float4 wGrain = woodGrain(float3(oP/4., 1. + frSh*.1));
    // Last minute adjustment: Toning the wood grain down a bit, if desired.
    //wGrain.xyz = mix(wGrain.xyz, wGrain.w*wGrain.w*float3(.85, .8, .75), .25);
 
    
    // Applying some cheap hatching.
    //wGrain.xyz *= hatch*.3 + .8;

    
    // The scene color. Initialized to zero.
    float3 col = F3(0);
     
    
    // Applying the background circle pattern.
    //float4 wGrainBg = woodGrain(float3(oP/3. + .5, 1.));
    //col = float3(.95, .8, .7)*(wGrainBg.w*.3 + .85);
    //col = mix(col, F3(0), (1. - smoothstep(0., sf*1.5, dBg.x))*.35);
    //col = mix(col, float3(.95, .8, .7)*(hatch*.2 + .9), (1. - smoothstep(0., sf, dBg.x + .05))*.7);

    // A cleaner background.
    //col = float3(.95, .8, .7);
    //col *= wGrainBg.w*.5 + .7;     
    
    // Applying some subtle hatching.
    //col *= hatch*.35 + .75;
         
    
    // Putting the frame shadow down first.
    // col = mix(col, F3(0), (1. - smoothstep(0., sf*15., fr2 - .05))*.65);
    
    // The frame.
    //col = mix(col, F3(0), (1. - smoothstep(0., sf*4., fr))*.5);
    //col = mix(col, wGrain.xyz*frSh, (1. - smoothstep(0., sf, fr)));
   
   
    // The frame content: In this case, the dot-like Truchet pattern.
    //col = mix(col, F3(.8) + hatch*.3, (1. - smoothstep(0., sf, sqr + frW*2.)));
    col = mix(col, float3(1, 1, 1), ( smoothstep(0., sf, d)));
    
    // Outer edging.
    //col = mix(col, float3(.1, .05, 0), (1. - smoothstep(0., sf*1.5, abs(fr + .01) - .01))*.85);
    
    // Inner edging... or something like that -- Like everyone else, I make this stuff 
    // up as I go along. :)
    //col = mix(col, F3(0), (1. - smoothstep(0., sf*1.5, abs(fr + .15) - .01))*.75);
    
    // Subtle highlighting.
    //col = mix(col, col*1.35, (1. - smoothstep(0., sf*4., max((fr + .02), -(fr2 + .02)))));

  
    // Cheap paper grain.
    //oP = floor(oP/gSc*1024.);
    //float3 rn3 = float3(hash21(oP), hash21(oP + 2.37), hash21(oP + 4.83));
    //col *= .9 + .1*rn3.xyz  + .1*rn3.xxx;    

     
     
    // Applying a subtle silhouette, for art's sake.
	uv = uv+_offset;
    //col *= pow(16.*(1. - uv.x)*(1. - uv.y)*uv.x*uv.y, 1./32.); 
    
    // Output to screen
    fragColor = float4(sqrt(max(col, 0.)), 1);
}



#define R iResolution.xy
  #define transS(d,r) smoothstep( 3.,0., (d)*R.y -r )  
#define RadiusToAngle 180./3.1415926    
#define AngleToRadius 3.1415926/180. 

float angle(float2 v1,float2 v2){
return  acos(dot(v1,v2)/(length(v1)*length(v2)))*RadiusToAngle;
}
float transline(float2 p, float2 a,float2 b, float r) { 
    p -= a, b -= a;
    float h = clamp(dot(p, b) / dot(b, b), 0., 2.), // proj coord on line
          d = length(p - b * h);                    // dist to segment
    return transS(  d , max(0.,r) );
}
float2 uvRotate(float2 uv,float rad){
return mul(float2x2(cos(rad), sin(rad),
        -sin(rad), cos(rad)),uv);}
void VortexTransition_float(float2 uv ,float scale,float2 _offset,out float4 fragColor)
{
    fragColor = F4(0);
    float2 U = uv-_offset;
    U.y *=-1.;
    //initialize
    float n =  64.,a,b, la = length(U),lb = length(U),dist = 1.,speed =2.,delay = 8.;
    //dist: line length adaptation according to rectangle 
    float ang = (angle(U,float2(1.,0.)));
    float threAngle = atan(R.y/R.x)*RadiusToAngle;
    if(ang>=threAngle&&ang<=180.-threAngle){
        if(ang<90.)dist /= cos((90.-ang)*AngleToRadius);
        else dist /= cos((ang-90.)*AngleToRadius);
    }else{
        if(ang<threAngle)dist *= (R.x/R.y)/cos((ang)*AngleToRadius);
        else dist *= (R.x/R.y)/cos((180.-ang)*AngleToRadius);}
        
     float2 Ub = uvRotate(U,-20.*AngleToRadius), Ua=U;
     a = (round((atan2(U.y,U.x))/TAU*n ))/n;
     b = (round((atan2(Ub.y,Ub.x))/TAU*n))/n;
     
     float period = .001;    
      
     float ta = ((scale+.5)*4.-(a+.5));
     float tb = ((scale+.5)*4.-(b+.5));
     if(scale<-0.4){ta = 0.;}
     if(scale<0.1){tb = 0.;}
     if( a<-.5+(round((scale+.25)*260.))/n)ta=1.;
     if( b<-.5+(round((scale)*260.))/n)tb=1.;
     Ua-=(abs(cos(mix(0.,pi/2.,ta))))*3.2*cos(TAU*a-float2(0,pi/2.));//delete the "dist"
     Ub-=(abs(cos(mix(0.,pi/2.,tb))))*3.2*cos(TAU*b-float2(0,pi/2.));
     
    la *=  18.;//width
    lb *=  48.;//width
    fragColor += transline( Ua, F2(0), cos(Tau*a-float2(0,pi/2.)) , la );
    fragColor += transline( Ub, F2(0), cos(Tau*b-float2(0,pi/2.)) , lb );
    fragColor = step(0.1,fragColor);
}


#define thick   0.04
#define smooth  (16.0 / iResolution.x)
#define eyeS(x) smoothstep(-smooth, smooth, x)
#define SR(x, y) smoothstep(-smooth * y, smooth * y, x)
#define scalex 5.
#define scaley 5.
#define scx (scalex * PI * 2.)

//Palettes by Inigo Quilez https://iquilezles.org/articles/palettes
float3 pal( in float t, in float3 a, in float3 b, in float3 c, in float3 d )
{
    return a + b*cos( 6.28318*(c*t+d) );
}
float3 pal1(in float t){
    return pal(t, float3(0.5,0.5,0.5),float3(0.5,0.5,0.5),float3(1.0,1.0,1.0),float3(0.0,0.33,0.67)) ;
}
float rand(float3 v){
    return fract(cos(dot(v,float3(13.46543,67.1132,123.546123)))*43758.5453);
}
float rand(float2 v){
    return fract(sin(dot(v,float2(5.11543,71.3177)))*43758.5453);
}
float rand(float v){
    return fract(sin(v * 71.3132)*43758.5453);
}

float2 rand2(float2 v){
    return float2(
        fract(sin(dot(v,float2(5.11543,71.3132)))*43758.5453),
        fract(sin(dot(v,float2(7.3113,21.5723)))*31222.1234)
        );
}
float smrand(float v){
    float vv = floor(v);
    return mix(rand(vv),rand(vv+1.0),fract(v));
}
float3 colorful(float2 fragCoord)
{
    float2 uv = fragCoord.xy / iResolution.xy;
    float2 pos = (uv.xy - 0.5);
    float2 cir = ((pos.xy * pos.xy + sin(uv.x * 18.0 + iTime) / 25.0 * sin(uv.y * 7.0 + iTime * 1.5) / 1.0) + uv.x * sin(iTime) / 16.0 + uv.y * sin(iTime * 1.2) / 16.0);
    float circles = (sqrt(abs(cir.x + cir.y * 0.5) * 25.0) * 5.0);
    
    float3 color = 1.0 - float3(sin(circles * 1.25 + 2.0), abs(sin(circles * 1.0 - 1.0) - sin(circles)), abs(sin(circles) * 1.0));
    
    return color;
}
float3 eye(float2 fst, float2 cst, float2 mouse,float3 iMouse,float2 st){
    float mouseDown = clamp(iMouse.z,0,1);
    float noise = rand(cst);
    
    float nt = iTime*2.0 * (noise + 0.8 ) +noise * 100.0;
    float fnt = floor(nt);
    float2 noise2 = rand2(cst + F2(fnt));
    float2 noise22 = rand2(cst + F2(fnt + 1.));
    float pinoise = noise2.x * PI * 2.0;
    float pinoise2 = noise22.x * PI * 2.0;
    float move = 1.0 - (cos(fract(nt)*PI)+1.0) /2.0;
    move = pow(move,4.0);
    
    float eyeOpen = (sin(iTime*2.0 + noise * 100.0) + 1.0) / 2.0;
    eyeOpen = mix(eyeOpen,0.0, mouseDown);
    eyeOpen = 1.0 - pow(eyeOpen, 3.0);
    
    float col = (sin(fst.x) + 1.)/2.0;
    //col = pow(col,0.9);
    float col2 = col* eyeOpen + fst.y*2.1 - 0.1;
    col = col* eyeOpen - fst.y*2.1 - 0.1;
    float cs1 = min(col - 0.1, col2- 0.1);
    float cs2 = eyeS(cs1);
    col = eyeS(min(col, col2));
    
    float grad = min(eyeOpen * 1.2, 1.);
    //float grad = min(1.0 - pow(1.0 -abs(fst.y),10.) + 0.3,1.0);
    
    float2 loc = float2(fract(fst.x/PI/2.0 + PI*2.0) - 0.53,fst.y*iResolution.y/iResolution.x);
    
    float2 pin2 = mix(float2(cos(pinoise),sin(pinoise))*((noise2.y +1.0) / 2.0),
                    float2(cos(pinoise2),sin(pinoise2))*((noise22.y +1.0) / 2.0),move);
    pin2 *= 0.25;
    pin2 =  mix(pin2, mouse, max(mouseDown - 0.05,0.));
    
    float lloc = length(loc);
    float irisn = mix(1.0,mix(noise2.x, noise22.x, move),0.25);
    float iris = length(loc - pin2 * (0.5 -lloc) );
    float irisWhite = length(loc - pin2 * (0.2 -lloc) );
    float irisDark = SR(length(loc - pin2 * (0.4 -lloc) ) - 0.05 * irisn,0.5);
    float irisShadow = SR(-irisWhite + 0.07,15.);
    irisWhite = SR(-irisWhite + 0.03,1.4);
    
    float3 irisColor = irisDark *pal1( irisShadow + nt/10.0);
    irisColor = max(irisColor, irisWhite*0.9);
    float3 baseCol = F3(SR(-lloc+ .25,15.));
    baseCol = baseCol + 0.25*pal1( baseCol.x + nt/10.0);
    
    float3 finCol = mix(baseCol, irisColor, eyeS(-iris + 0.15));
    finCol = mix(pal1(noise + nt/10.0) * grad,finCol, cs2);
    finCol = min(finCol, col);
    
    return finCol;
}
void EyeBall_float(float2 uv ,float scale,float2 _offset,float3 iMouse,out float4 fragColor){
    float2 st = uv;
    st*=scale;
    st -= _offset;
    float2 mouse = (iMouse.xy);
    
    float fsty = fract(st.y * scaley) - 0.5;
    float fsty2 = fract(st.y * scaley  + 0.5) - 0.5;
    float csty = floor(st.y * scaley);
    float csty2 = floor(st.y * scaley + 0.5);
    float cstx = floor(st.x * scalex);
    float cstx2 = floor(st.x * scalex + 0.5);
    float2 cst = float2(cstx,csty);
    float2 cst2 = float2(cstx2,csty2 + 1234.);
    float2 fst = float2(st.x * scx - 0.5 * PI, fsty);
    float2 fst2 = float2(st.x * scx + 0.5 * PI, fsty2);

    
    float2 m1 = mouse - float2((cstx + 0.5)/scalex, (csty + 0.5)/scaley);
    float2 m2 = mouse - float2((cstx2 + 0.5)/scalex, (csty2 + 0.5)/scaley);
    
    float3 col = eye(fst, cst, m1,iMouse,st);
    float3 col2 = eye(fst2, cst2, m2,iMouse,st);
    col = max(col,col2);
    //col += 0.1 * (rand(uv.xy*iResolution.xy/3.0 + iTime)-0.5);
    //col -= 0.1 * (rand(fragCoord.xy/3.0 + iTime + 100.0));
  
    fragColor = float4(col, 1.0);
}

    
float3 eye2(float2 fst, float2 cst, float2 mouse,float3 iMouse,float2 st,float mouseOn,float mouseClick){
    float mouseDown = mouseOn;
    float noise = rand(cst);
    
    float nt = iTime*2.0 * (noise + 0.8 ) +noise * 100.0;
    float fnt = floor(nt);
    float2 noise2 = rand2(cst + F2(fnt));
    float2 noise22 = rand2(cst + F2(fnt + 1.));
    float pinoise = noise2.x * PI * 2.0;
    float pinoise2 = noise22.x * PI * 2.0;
    float move = 1.0 - (cos(fract(nt)*PI)+1.0) /2.0;
    move = pow(move,4.0);
    
    float eyeOpen = (sin(2.0+mouseClick/100 + noise * 100.0) + 1.0) / 2.0;
    eyeOpen = mix(eyeOpen,0.0, mouseDown);
    eyeOpen = 1.0 - pow(eyeOpen, 3.0);
    
    float col = (sin(fst.x) + 1.)/2.0;
    //col = pow(col,0.9);
    float col2 = col* eyeOpen + fst.y*2.1 - 0.1;
    col = col* eyeOpen - fst.y*2.1 - 0.1;
    float cs1 = min(col - 0.1, col2- 0.1);
    float cs2 = eyeS(cs1);
    col = eyeS(min(col, col2));
    
    float grad = min(eyeOpen * 1.2, 1.);
    //float grad = min(1.0 - pow(1.0 -abs(fst.y),10.) + 0.3,1.0);
    
    float2 loc = float2(fract(fst.x/PI/2.0 + PI*2.0) - 0.53,fst.y*iResolution.y/iResolution.x);
    
    float2 pin2 = mix(float2(cos(pinoise),sin(pinoise))*((noise2.y +1.0) / 2.0),
                    float2(cos(pinoise2),sin(pinoise2))*((noise22.y +1.0) / 2.0),move);
    pin2 *= 0.25;
    pin2 =  mix(pin2, mouse, max(mouseDown - 0.05,0.));
    
    float lloc = length(loc);
    float irisn = mix(1.0,mix(noise2.x, noise22.x, move),0.25);
    float iris = length(loc - pin2 * (0.5 -lloc) );
    float irisWhite = length(loc - pin2 * (0.2 -lloc) );
    float irisDark = SR(length(loc - pin2 * (0.4 -lloc) ) - 0.05 * irisn,0.5);
    float irisShadow = SR(-irisWhite + 0.07,15.);
    irisWhite = SR(-irisWhite + 0.03,1.4);
    
    float3 irisColor =irisDark *colorful(st);
    irisColor = max(irisColor, irisWhite*0.9);
    float3 baseCol = F3(SR(-lloc+ .25,15.));
    baseCol = baseCol + 0.25*pal1( baseCol.x + nt/10.0);
    
    float3 finCol = mix(baseCol, irisColor, eyeS(-iris + 0.15));
    finCol = mix(0,finCol, cs2);
    finCol = min(finCol, col);
    
    return finCol;
}
void EyeBall2_float(float2 uv ,float scale,float2 _offset,float3 iMouse,float mouseOn,float mouseClick,out float4 fragColor){
    float2 st = uv;
    st*=scale;
    st -= _offset;
    float2 mouse = (iMouse.xy);
    float sx = 1.0;
    float sy = 4.0;
    float fsty = fract(st.y * sy) - 0.5;
    float fsty2 = fract(st.y * sy  + 0.5) - 0.5;
    float csty = floor(st.y * sy);
    float csty2 = floor(st.y * sy + 0.5);
    float cstx = floor(st.x * sx);
    float cstx2 = floor(st.x * sx + 0.5);
    float2 cst = float2(cstx,csty);
    float2 fst = float2(st.x * scx - 0.5 * PI, fsty);

    
    float2 m1 = mouse - float2((cstx + 0.5)/scalex, (csty + 0.5)/scaley);
    float2 m2 = mouse - float2((cstx2 + 0.5)/scalex, (csty2 + 0.5)/scaley);
    
    float3 col = eye2(fst, cst, m1,iMouse,st*_ScreenParams.xy*5,mouseOn,mouseClick);
    //col += 0.1 * (rand(uv.xy*iResolution.xy/3.0 + iTime)-0.5);
    //col -= 0.1 * (rand(fragCoord.xy/3.0 + iTime + 100.0));
  
    fragColor = float4(col, 1.0);
}




void Gold_float(float2 uv ,float scale,float variation, out float4 baseColor)
{
    float2 p = 5.*(( (uv*_ScreenParams.xy).xy-.5* iResolution.xy )/iResolution.y)-.5 ;
    p*=float2(scale,variation);
    float2 i = p;
	float c = 0.0;
	float r = length(p+float2(sin(iTime),sin(iTime*.22+99.))*1.5);
	float d = length(p);
	float rot = d+iTime+p.x*.15; 
	for (float n = 0.0; n < 4.0; n++) {
		p = mul(float2x2(cos(rot-sin(iTime/4.)), sin(rot), -sin(cos(rot)-iTime), cos(rot))*-0.15,p);
		float t = r-iTime/(n+1.5);
		i -= p + float2(cos(t - i.x-r) + sin(t + i.y),sin(t - i.y) + cos(t + i.x)+r);
		c += 1.0/length(float2((sin(i.x+t)/.15), (cos(i.y+t)/.15)));
	}
	c /= 4.0;
	baseColor = vec4(F3(c)*float3(4.3, 3.4, 0.1)-0.35, .1);
}



float3 drawImage(float2 uv,float speed){
    float ang=iTime+(speed*-(sin(iTime)*.5+.5));
    float2x2 rot=float2x2(cos(ang),-sin(ang),sin(ang),cos(ang));
    uv=mul(rot,uv);
    
    float3 col=F3(.5);
    float2 w=uv-float2(-.1,-.25);
    float2 b=uv-float2(.1,.25);
    
    float m=uv.x*7.-sin(uv.y*3.14*2.-3.14);
    m=smoothstep(-.2,.2,m);
    
    col*=mix(2.-smoothstep(.1+.35*(sin(iTime)*.5+.5),.5,length(uv)),smoothstep(.1+.35*(sin(iTime)*.5+.5),.5,length(uv)),m);
    
    col+=F3(.001/dot(b,b));
    col+=F3(.001/dot(w,w))*F3(-1.);
    return col;
}

float2 fixUV(float2 st){
    if(iResolution.x>iResolution.y){
        st.x*=iResolution.x/iResolution.y;
    }
    else{
        st.y*=iResolution.y/iResolution.x;
    }
    return st;
}

void TaichiPattern_float(float2 uv ,float2 _offset,float2 scale,float speed, out float4 baseColor)
{
uv+=_offset;uv*=scale;
    uv =( uv);
    uv-=0.5;
    uv=fixUV(uv);
    
    float3 col = F3(0.0);
    float a=.5;
        col+=drawImage(uv,(float(1)+1.)*.1)*2.;
   col = clamp(col,0.,1.);
   col = 1. -col;
   
    baseColor = vec4(col,1.0);
}